print("                      On your way there, you will face many trials that will test your skills as a baker and a cat.")
print("                      You must ensure my cupcakes are delivered on time and in one piece if you want to succeed!")

# The player chooses what to do
answer = input("Will you accept this challenge and deliver the cupcakes? (yes/no): ")

if answer == "yes":
    print(name + ": I cannot wait to complete this quest and earn coins!")
else:
    print("The mermaid Princess: How could you refuse such a noble quest! ")
    print("You have failed the princess and your bakery will be closed forever!")

